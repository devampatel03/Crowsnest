# Crowsnest FastAPI backend (CoralEngine + LangGraph agents).
# Build context is the repo root (see infra/docker-compose.yml: context: ..).
FROM python:3.12-slim

WORKDIR /app

# No compiler is installed: the dependencies ship wheels for python:3.12-slim. (build-essential pulled in
# about 300 MB of OS packages, and a failed or killed apt step blocked the whole image.)
# Pick up Debian security fixes published after the base image was built. git is there so `crowsnest check` can read
# a lockfile as it was at the base of a pull request.
RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

# Copy only what the install needs first, to keep layer caching useful.
COPY pyproject.toml ./
COPY packages/core ./packages/core
# Seed data (known IOCs and hallucination patterns). db/seed.py reads it from <repo>/coral-config; without
# it the IOC and slopsquatting detections run with no data.
COPY coral-config ./coral-config

# A long timeout and extra retries keep the build alive on a slow or flaky connection.
RUN pip install --no-cache-dir --default-timeout=120 --retries=10 .

# Run as an unprivileged user; /data is the only writable location.
RUN useradd --create-home --uid 10001 crowsnest \
    && mkdir -p /data/snapshots \
    && chown -R crowsnest:crowsnest /data
USER crowsnest

# CROWSNEST_DB_PATH / CROWSNEST_SNAPSHOT_DIR are overridden by docker-compose to
# point at the mounted /data volume; these are just sane container defaults.
# The command line shares a folder of the user's projects at /projects (read only). git refuses a repository owned
# by another user, which is what a shared folder is, so the check may read any repository there.
ENV CROWSNEST_DB_PATH=/data/crowsnest.duckdb \
    CROWSNEST_SNAPSHOT_DIR=/data/snapshots \
    CROWSNEST_PROJECTS_ROOT=/projects \
    GIT_CONFIG_COUNT=1 \
    GIT_CONFIG_KEY_0=safe.directory \
    GIT_CONFIG_VALUE_0=* \
    PYTHONUNBUFFERED=1

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD python -c "import urllib.request,sys; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=4)" || exit 1

CMD ["uvicorn", "packages.core.api:app", "--host", "0.0.0.0", "--port", "8000"]
