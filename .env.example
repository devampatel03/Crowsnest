# Crowsnest Environment Configuration
# Every key below is optional: Crowsnest starts and falls back to saved data without them.

# AI Model
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# GitHub (for repo/commit/workflow queries)
GITHUB_TOKEN=your_github_token_here
GITHUB_ORG=your_org_name_here

# Socket.dev (for behavioral analysis)
SOCKET_API_KEY=your_socket_api_key_here

# npm (optional, for private registry)
NPM_TOKEN=

# Slack Bot — https://api.slack.com/apps
# SLACK_BOT_TOKEN: Bot User OAuth Token (xoxb-...)
# SLACK_APP_TOKEN: App-Level Token with connections:write scope (xapp-...) for Socket Mode
# SLACK_SIGNING_SECRET: from App Basic Information page
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_APP_TOKEN=xapp-your-app-token-here
SLACK_SIGNING_SECRET=your_signing_secret_here
CROWSNEST_ALERT_CHANNEL=#security

# Linear (for ticket creation)
LINEAR_API_KEY=

# Database
CROWSNEST_DB_PATH=./crowsnest.duckdb
CROWSNEST_SNAPSHOT_DIR=./snapshots

# API server
# The API has no authentication. Keep it on loopback (127.0.0.1) unless something you trust
# sits in front of it. The Docker Compose file publishes the port on 127.0.0.1 only.
CROWSNEST_API_HOST=127.0.0.1
CROWSNEST_API_PORT=8000
# Browser origins allowed to call the API (comma-separated)
CROWSNEST_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Dashboard
NEXT_PUBLIC_API_URL=http://localhost:8000
# The console (Horizon, Lookout, Hold, Log) opens only on the machine running Crowsnest and answers 404 on a public
# site. Set CROWSNEST_CONSOLE=on to open it anyway (for example behind your own login), or off to close it everywhere.
# CROWSNEST_CONSOLE=on
# Public origin of the website. Baked into canonical URLs, the sitemap and robots.txt at build
# time; a production build refuses localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Slack bot (points to the Python API)
CROWSNEST_API_URL=http://localhost:8000
# Where the Slack bot links to the dashboard
CROWSNEST_DASHBOARD_URL=http://localhost:3000

# VS Code Extension — set in VS Code settings (crowsnest.apiUrl)
# Default: http://localhost:8000
