# Crowsnest settings. Every line is optional: Crowsnest starts and works with none of them.
# Copy this file to .env in the Crowsnest folder and remove the # from the lines you want.

# --- Docker Compose --------------------------------------------------------------------
# The folder that holds your projects. It is shared read only, and the scan dialog lists
# the projects inside it. Use a full path.
#   macOS / Linux: /home/you/code        Windows: C:\Users\you\code
CROWSNEST_PROJECTS=

# --- AI model (optional) ---------------------------------------------------------------
# Without a model, fixed rules do the work. Set the key for ONE provider and Crowsnest
# finds it: ANTHROPIC_API_KEY, OPENAI_API_KEY, GEMINI_API_KEY, GROQ_API_KEY,
# MISTRAL_API_KEY, DEEPSEEK_API_KEY, TOGETHER_API_KEY, XAI_API_KEY or OPENROUTER_API_KEY.
# Ollama and LM Studio run on your machine and need no key.
# All providers: https://crowsnest.co.in/docs/integrations/models
# ANTHROPIC_API_KEY=
# CROWSNEST_LLM_PROVIDER=ollama
# CROWSNEST_LLM_MODEL=llama3.1

# --- Live lookups (optional) -----------------------------------------------------------
# GITHUB_TOKEN=
# GITHUB_ORG=
# SOCKET_API_KEY=
# NPM_TOKEN=


# --- Slack bot (optional) --------------------------------------------------------------
# `npm run setup` in packages/slack-bot fills in the two tokens for you.
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
# CROWSNEST_ALERT_CHANNEL=#security
# CROWSNEST_DASHBOARD_URL=http://localhost:3000

# --- Addresses and storage (the defaults are fine for most people) ---------------------
# The API has no login: keep it on 127.0.0.1 unless something you trust sits in front of it.
CROWSNEST_API_HOST=127.0.0.1
CROWSNEST_API_PORT=8000
CROWSNEST_API_URL=http://localhost:8000
CROWSNEST_DB_PATH=./crowsnest.duckdb
CROWSNEST_SNAPSHOT_DIR=./snapshots
# Browser addresses allowed to call the API. Add yours if you move the dashboard off port 3000.
CROWSNEST_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Dashboard -------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
# The dashboard opens only on the machine running it.

# CROWSNEST_CONSOLE=on

# Public address of the website, used for links and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
