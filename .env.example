# Crowsnest Environment Configuration

# AI Model
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# GitHub (for repo/commit/workflow queries)
GITHUB_TOKEN=your_github_token_here
GITHUB_ORG=your_org_name_here

# Socket.dev (for behavioral analysis)
SOCKET_API_KEY=your_socket_api_key_here

# npm (optional, for private registry)
NPM_TOKEN=

# Slack Bot — https://api.slack.com/apps
# SLACK_BOT_TOKEN: Bot User OAuth Token (xoxb-...)
# SLACK_APP_TOKEN: App-Level Token with connections:write scope (xapp-...) for Socket Mode
# SLACK_SIGNING_SECRET: from App Basic Information page
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_APP_TOKEN=xapp-your-app-token-here
SLACK_SIGNING_SECRET=your_signing_secret_here
CROWSNEST_ALERT_CHANNEL=#security

# Linear (for ticket creation)
LINEAR_API_KEY=

# Database
CROWSNEST_DB_PATH=./crowsnest.duckdb
CROWSNEST_SNAPSHOT_DIR=./snapshots

# API server
CROWSNEST_API_HOST=0.0.0.0
CROWSNEST_API_PORT=8000

# Dashboard
NEXT_PUBLIC_API_URL=http://localhost:8000

# Slack bot (points to the Python API)
CROWSNEST_API_URL=http://localhost:8000

# VS Code Extension — set in VS Code settings (crowsnest.apiUrl)
# Default: http://localhost:8000
