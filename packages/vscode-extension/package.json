{
  "name": "crowsnest-vscode",
  "displayName": "Crowsnest — Supply Chain Sentinel",
  "description": "Inline supply chain risk warnings. See the storm before it hits your ship.",
  "version": "0.1.0",
  "publisher": "crowsnest",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Linters", "Other"],
  "keywords": ["supply chain", "security", "npm", "slopsquatting"],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact",
    "onLanguage:python"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "crowsnest.scanFile",
        "title": "Crowsnest: Scan Current File"
      },
      {
        "command": "crowsnest.investigatePackage",
        "title": "Crowsnest: Investigate Package Under Cursor"
      },
      {
        "command": "crowsnest.openDashboard",
        "title": "Crowsnest: Open Dashboard"
      }
    ],
    "configuration": {
      "title": "Crowsnest",
      "properties": {
        "crowsnest.apiUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "Crowsnest API base URL"
        },
        "crowsnest.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable inline risk warnings"
        },
        "crowsnest.riskThreshold": {
          "type": "number",
          "default": 0.5,
          "description": "Risk score threshold for showing warnings (0-1)"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "build": "npm run compile",
    "dev": "npm run watch",
    "typecheck": "tsc --noEmit -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {}
}
