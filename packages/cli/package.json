{
  "name": "@crowsnest/cli",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Crowsnest supply chain security CLI: scan lockfiles, investigate packages, and veto risky npm installs",
  "keywords": [
    "supply-chain",
    "security",
    "npm",
    "typosquatting",
    "slopsquatting",
    "dependency-confusion",
    "lockfile",
    "cli"
  ],
  "homepage": "https://github.com/devampatel03/Crowsnest#readme",
  "bugs": {
    "url": "https://github.com/devampatel03/Crowsnest/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devampatel03/Crowsnest.git",
    "directory": "packages/cli"
  },
  "author": "Devam Patel",
  "type": "module",
  "bin": {
    "crowsnest": "dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run lint && npm test && npm run build",
    "dev": "tsx src/index.ts",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "conf": "^16.0.0",
    "date-fns": "^3.6.0",
    "eventsource": "^2.0.2",
    "ora": "^8.0.1",
    "semver": "^7.6.3",
    "table": "^6.8.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/semver": "^7.5.8",
    "eslint": "^9.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0"
  },
  "types": "./dist/index.d.ts"
}
