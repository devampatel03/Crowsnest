{
  "name": "crowsnest",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-source supply chain forensics agent — see the storm before it hits your ship",
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "packages/cli",
    "packages/dashboard",
    "packages/vscode-extension",
    "packages/slack-bot"
  ],
  "scripts": {
    "dev": "pnpm --parallel --if-present run dev",
    "build": "pnpm --parallel --if-present run build",
    "lint": "pnpm --parallel --if-present run lint",
    "typecheck": "pnpm --parallel --if-present run typecheck",
    "test": "pnpm --parallel --if-present run test"
  }
}
