{
  "name": "crowsnest",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-source supply chain forensics agent — see the storm before it hits your ship",
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "packages/cli",
    "packages/dashboard",
    "packages/vscode-extension",
    "packages/slack-bot",
    "packages/shared"
  ],
  "scripts": {
    "dev": "pnpm --parallel run dev",
    "build": "pnpm --parallel run build",
    "lint": "pnpm --parallel run lint",
    "typecheck": "pnpm --parallel run typecheck"
  }
}
